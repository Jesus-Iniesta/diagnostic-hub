# --- Aplicación ---
APP_NAME=PuntoVenta API
APP_VERSION=1.0.0
DEBUG=false

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/integrativa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=integrativa

# --- Seguridad ---
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS (orígenes del frontend, separados por comas) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api/v1